# eit-market-data — local environment for the Mac Mini daily batch.
# Copy to .env and fill in real values. .env is gitignored; never commit it.
#
#   cp .env.example .env
#
# Loaded automatically by scripts/run_daily_batch.py (python-dotenv).

# --- KR enrichment (recommended) ---
# OpenDART: financial statements + filings.  https://opendart.fss.or.kr
DART_API_KEY=
# Bank of Korea ECOS: macro indicators.       https://ecos.bok.or.kr/api
ECOS_API_KEY=

# --- KR official raw crawl (pykrx KRXSession auth) ---
# Needed by scripts/crawl_kr_data_pykrx.py when the official path requires login.
KRX_ID=
KRX_PW=

# --- US providers (required for the US snapshot) ---
# FRED macro.  https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# SEC EDGAR requires an identifying User-Agent: "Name email@example.com"
SEC_EDGAR_USER_AGENT=

# --- Optional tuning ---
# TZ=Asia/Seoul
# EIT_DART_CACHE_SIZE_LIMIT_BYTES=
